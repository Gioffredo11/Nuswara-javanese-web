# ==============================================================================
# JAWA EPIC - BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database Connection (MySQL 8 / MariaDB)
DATABASE_URL="mysql://root:@127.0.0.1:3306/jawa_epic"

# Guest Session & JWT Signing Secret (Minimum 32 characters cryptographic entropy)
SESSION_SECRET="jawa_epic_session_secret_change_me_in_production_min_32_chars"

# Initial Admin Credentials (used by seed & admin header authentication guard)
ADMIN_EMAIL="admin@jawaepic.id"
ADMIN_PASSWORD="supersecretadminpassword123"

# Base Application URL for Generating Canonical Share Links & Previews
APP_BASE_URL="http://localhost:3000"

# Photobooth Upload File Limits (in bytes; 5242880 = 5MB)
UPLOAD_MAX_BYTES="5242880"

# Share Link Default Time-To-Live in Days (e.g., 30 days)
SHARE_TTL_DAYS="30"
