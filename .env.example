# ==============================================================================
# NUSWARA — ENVIRONMENT CONFIGURATION
# Salin file ini ke .env lalu isi nilainya. Jangan commit .env ke repository!
# ==============================================================================

# Database Connection (MySQL 8 / MariaDB)
DATABASE_URL="mysql://root:PASSWORD@127.0.0.1:3306/jawa_epic"

# Guest Session & JWT Signing Secret
# Generate dengan: node -e "require('crypto').randomBytes(48).toString('hex')"
SESSION_SECRET="GANTI_INI_DENGAN_RANDOM_STRING_MIN_48_KARAKTER"

# Admin Credentials (dipakai oleh admin-guard middleware)
# WAJIB di-set sebelum deploy. Jika tidak di-set, server akan menolak start.
ADMIN_EMAIL="admin@domain-anda.id"
ADMIN_PASSWORD="GANTI_INI_DENGAN_PASSWORD_KUAT_MIN_20_KARAKTER"

# Base URL aplikasi (untuk CORS dan canonical links)
# Contoh: https://nuswara.id atau http://localhost:3000
APP_BASE_URL="http://localhost:3000"

# (Opsional) Tambahan origin yang diizinkan CORS, pisah koma
# Contoh: https://admin.nuswara.id,https://preview.nuswara.id
EXTRA_ALLOWED_ORIGINS=""

# Photobooth Upload File Limits (dalam bytes; 5242880 = 5MB)
UPLOAD_MAX_BYTES="5242880"

# Share Link Default Time-To-Live dalam hari
SHARE_TTL_DAYS="30"
