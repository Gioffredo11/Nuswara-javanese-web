{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nuswara-javanese-web",
  "build": {
    "command": "npx opennextjs-cloudflare build"
  },
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": {
    "enabled": true
  }
}
